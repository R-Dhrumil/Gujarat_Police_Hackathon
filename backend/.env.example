# Gujarat State Unified CCTV Command Center - Backend Environment Template

PROJECT_NAME="Gujarat State Unified CCTV & GIS Platform"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Security
SECRET_KEY="replace_with_a_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL="sqlite:///./cctv_registry.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/cctv_registry"

# Hackathon Camera Grid Ingestion Base Host
GRID_HOST="http://localhost:8080"
GRID_CATALOGUE_PATH="/api/ingest"

# Default Gujarat Map Center
DEFAULT_MAP_LAT=23.2156
DEFAULT_MAP_LNG=72.6369
DEFAULT_MAP_ZOOM=8
